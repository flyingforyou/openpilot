From 7ba825893edcba9c80915c070d3dc9b3cacc6c36 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Mon, 27 Jul 2026 21:29:51 +0000
Subject: [PATCH] tesla: use steering wheel gap for longitudinal control

Decode the legacy Model S/X DTR distance setting and publish it through CarState. Use the selected gap for MPC time following with a rate-limited increase, and show gap changes plus the primary lead perception source on the onroad HUD.
---
 opendbc_repo/opendbc/car/car.capnp            |  1 +
 opendbc_repo/opendbc/car/tesla/carstate.py    | 23 ++++++++
 .../opendbc/car/tesla/tests/test_tesla.py     | 20 +++++++
 .../lib/longitudinal_mpc_lib/long_mpc.py      | 39 +++++++++++-
 .../controls/lib/longitudinal_planner.py      |  3 +-
 .../controls/tests/test_following_distance.py | 29 ++++++++-
 selfdrive/ui/onroad/hud_renderer.py           | 59 +++++++++++++++++++
 7 files changed, 169 insertions(+), 5 deletions(-)

diff --git a/opendbc_repo/opendbc/car/car.capnp b/opendbc_repo/opendbc/car/car.capnp
--- a/opendbc_repo/opendbc/car/car.capnp
+++ b/opendbc_repo/opendbc/car/car.capnp
@@ -6,6 +6,7 @@ struct CarState {
     available @2 :Bool;
     standstill @4 :Bool;
     nonAdaptive @5 :Bool;
+    gapAdjust @7 :UInt8;  # 0: unavailable, Tesla legacy: 1-7
 
     speedOffsetDEPRECATED @3 :Float32;
   }
diff --git a/opendbc_repo/opendbc/car/tesla/carstate.py b/opendbc_repo/opendbc/car/tesla/carstate.py
--- a/opendbc_repo/opendbc/car/tesla/carstate.py
+++ b/opendbc_repo/opendbc/car/tesla/carstate.py
@@ -9,6 +9,22 @@ from opendbc.car.tesla.values import DBC, CANBUS, GEAR_MAP, STEER_THRESHOLD, Tes
 
 ButtonType = structs.CarState.ButtonEvent.Type
 
+
+TESLA_DTR_RAW_TO_GAP = {
+  0: 1,
+  33: 2,
+  66: 3,
+  100: 4,
+  133: 5,
+  166: 6,
+  200: 7,
+}
+
+
+def decode_tesla_gap(raw_gap: int) -> int:
+  return TESLA_DTR_RAW_TO_GAP.get(int(raw_gap), 0)
+
+
 class CarState(CarStateBase):
   def __init__(self, CP):
     super().__init__(CP)
@@ -40,6 +56,7 @@ class CarState(CarStateBase):
 
     self.hands_on_level = 0
     self.das_control = None
+    self.cruise_gap = 0
   def update_autopark_state(self, autopark_state: str, cruise_enabled: bool):
     autopark_now = autopark_state in ("ACTIVE", "COMPLETE", "SELFPARK_STARTED")
     if autopark_now and not self.autopark_prev and not self.cruise_enabled_prev:
@@ -95,6 +112,12 @@ class CarState(CarStateBase):
     if self.CP.carFingerprint == CAR.TESLA_MODEL_X_HW1:
       ret.leftBlinker = cp_chassis.vl["STW_ACTN_RQ"]["TurnIndLvr_Stat"] == 1
       ret.rightBlinker = cp_chassis.vl["STW_ACTN_RQ"]["TurnIndLvr_Stat"] == 2
+      gap_samples = cp_chassis.vl_all["STW_ACTN_RQ"]["DTR_Dist_Rq"]
+      if gap_samples:
+        decoded_gap = decode_tesla_gap(gap_samples[-1])
+        if decoded_gap:
+          self.cruise_gap = decoded_gap
+      ret.cruiseState.gapAdjust = self.cruise_gap
     else:
       ret.leftBlinker = cp_chassis.vl["GTW_carState"]["BC_indicatorLStatus"] == 1
       ret.rightBlinker = cp_chassis.vl["GTW_carState"]["BC_indicatorRStatus"] == 1
