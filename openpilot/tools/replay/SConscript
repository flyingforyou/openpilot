Import('env', 'arch', 'common', 'messaging', 'visionipc', 'cereal', 'ffmpeg_libs')

replay_env = env.Clone()
replay_env['CCFLAGS'] += ['-Wno-deprecated-declarations']

base_frameworks = ['VideoToolbox', 'CoreMedia', 'CoreFoundation', 'CoreVideo'] if arch == "Darwin" else []
base_libs = [common, messaging, cereal, visionipc, 'm', 'pthread']

replay_lib_src = ["replay.cc", "consoleui.cc", "camera.cc", "filereader.cc", "logreader.cc", "framereader.cc",
                  "route.cc", "util.cc", "seg_mgr.cc", "timeline.cc", "py_downloader.cc"]
if arch != "Darwin":
  # Named apart from loggerd's object rather than shared. On comma hardware loggerd builds this
  # same file, and replay_env adds -Wno-deprecated-declarations, so scons sees one target wanted
  # by two different actions and refuses -- which is why replay could not be built on the device
  # at all, despite tools/replay/README-comma4-onroad.md documenting exactly that.
  replay_lib_src.append(replay_env.Object("v4l_decoder_replay",
                                          "#openpilot/system/loggerd/encoder/v4l_decoder.cc"))
replay_lib = replay_env.Library("replay", replay_lib_src, LIBS=base_libs, FRAMEWORKS=base_frameworks)
Export('replay_lib')
replay_libs = [replay_lib] + ffmpeg_libs + ['ncurses'] + base_libs
replay_env.Program("replay", ["main.cc"], LIBS=replay_libs, FRAMEWORKS=base_frameworks)
